{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "{{default title "Webhook notification"}}",
      "weight": "Bolder",
      "size": "Medium",
      "wrap": true
    },
    {
      "type": "FactSet",
      "facts": [
        {{#eachFacts this}}
        { "title": "{{escapeJson key}}", "value": "{{escapeJson value}}" }{{#unless last}},{{/unless}}
        {{/eachFacts}}
      ]
    }
  ]
}
