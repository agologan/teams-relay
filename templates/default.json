{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "{{escapeJson (default title 'Webhook notification')}}",
      "weight": "Bolder",
      "size": "Medium",
      "wrap": true
    },
    {
      "type": "FactSet",
      "facts": [
        {{#each this}}
        { "title": "{{escapeJson @key}}", "value": "{{escapeJson this}}" }{{#unless @last}},{{/unless}}
        {{/each}}
      ]
    }
  ]
}
