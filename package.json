{
  "name": "teams-relay",
  "version": "1.0.0",
  "description": "Teams bot service replacing legacy webhooks",
  "license": "Apache-2.0",
  "author": "",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsgo",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsgo --noEmit",
    "fmt": "oxfmt",
    "dynamodb:create-table": "node --env-file-if-exists=.env --import tsx src/scripts/create-table.ts",
    "manifest": "zip -j manifest.zip manifest/*",
    "manifest:validate": "node scripts/validate-manifest.mjs",
    "test": "echo \"No tests yet\""
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1052.0",
    "@aws-sdk/lib-dynamodb": "^3.1052.0",
    "@hono/node-server": "^2.0.3",
    "botbuilder": "^4.23.3",
    "handlebars": "^4.7.9",
    "hono": "^4.12.22",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript/native-preview": "7.0.0-dev.20260607.1",
    "ajv-draft-04": "^1.0.0",
    "oxfmt": "^0.53.0",
    "tsx": "^4.22.3"
  },
  "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485"
}
