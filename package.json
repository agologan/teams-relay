{
  "name": "teams-relay",
  "version": "1.0.0",
  "description": "Teams bot service replacing legacy webhooks",
  "license": "Apache-2.0",
  "author": "",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "dynamodb:create-table": "node --env-file-if-exists=.env --import tsx src/scripts/create-table.ts",
    "manifest": "zip -j manifest.zip manifest/*",
    "manifest:validate": "node scripts/validate-manifest.mjs",
    "test": "node --import tsx --test tests/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1129.0",
    "@aws-sdk/lib-dynamodb": "^3.1129.0",
    "@hono/node-server": "^2.1.1",
    "botbuilder": "^4.23.3",
    "handlebars": "^4.7.9",
    "hono": "^4.13.7",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "oxfmt": "^0.67.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    }
  }
}
