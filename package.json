{
  "name": "teams-relay",
  "version": "1.0.0",
  "description": "Teams bot service replacing legacy webhooks",
  "license": "Apache-2.0",
  "author": "",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "dynamodb:create-table": "node --env-file-if-exists=.env --import tsx src/scripts/create-table.ts",
    "manifest": "zip -j manifest.zip manifest/*",
    "manifest:validate": "node scripts/validate-manifest.mjs",
    "test": "node --import tsx --test tests/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1129.0",
    "@aws-sdk/lib-dynamodb": "^3.1129.0",
    "@hono/node-server": "^2.1.1",
    "botbuilder": "^4.23.3",
    "handlebars": "^4.7.9",
    "hono": "^4.13.7",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "ajv-draft-04": "^1.0.0",
    "oxfmt": "^0.67.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
