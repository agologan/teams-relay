{
  "name": "teams-relay",
  "version": "1.0.0",
  "description": "Teams bot service replacing legacy webhooks",
  "license": "Apache-2.0",
  "author": "",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsgo",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsgo --noEmit",
    "fmt": "oxfmt",
    "dynamodb:create-table": "node --env-file-if-exists=.env --import tsx src/scripts/create-table.ts",
    "manifest": "zip -j manifest.zip manifest/*",
    "manifest:validate": "node scripts/validate-manifest.mjs",
    "test": "node --import tsx --test tests/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1053.0",
    "@aws-sdk/lib-dynamodb": "^3.1053.0",
    "@hono/node-server": "^2.0.4",
    "botbuilder": "^4.23.3",
    "handlebars": "^4.7.9",
    "hono": "^4.12.23",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript/native-preview": "7.0.0-dev.20260607.1",
    "ajv-draft-04": "^1.0.0",
    "oxfmt": "^0.53.0",
    "tsx": "^4.22.3"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
