{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "digest", "rollback"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true,
    "automergeType": "branch",
    "labels": ["security"]
  }
}
